# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres for LangGraph checkpointer (@agents/agent).
# Direct host db.<ref>.supabase.co is IPv6-only. On IPv4-only networks you get ENOTFOUND — use Session pooler instead.
# Dashboard: Connect → Method "Session pooler" → copy URI (host like aws-0-<region>.pooler.supabase.com, user postgres.<ref>).
# Transaction pooler (port 6543) is not suitable here.
DATABASE_URL=

# OpenRouter
OPENROUTER_API_KEY=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Calendar OAuth (optional) — same app can use OAuth consent + Calendar API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. If unset, the app uses <origin>/api/integrations/google-calendar/callback from the request.
# Do not set to empty — Google returns invalid_request. When set, must exactly match Google Cloud Console.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=

# OAuth encryption
OAUTH_ENCRYPTION_KEY=

# Bash tool (optional, high-risk)
# Set to "true" to enable execution of bash commands on the server host.
# Leave unset or set to any other value to disable (fail-closed default).
BASH_TOOL_ENABLED=
# Absolute path to use as working directory for bash commands.
# Defaults to process.cwd() if unset or invalid.
BASH_TOOL_CWD=

# File tools (optional, read_file / write_file / edit_file)
# Set FILE_TOOLS_ENABLED=true to enable file read/write/edit operations on the server host.
# Leave unset or set to any other value to disable (fail-closed default).
# Paths passed to file tools can be absolute or relative to the server process working directory,
# matching the same behaviour as the bash tool — no root confinement is enforced.
FILE_TOOLS_ENABLED=

# Scheduled tasks cron runner
# A secret token that Supabase Cron (or any external caller) must send in the
# Authorization header as "Bearer <value>" when hitting /api/cron/scheduled-tasks.
# Leave empty to disable authentication (not recommended for production).
CRON_SECRET=

# Next.js (optional)
NEXT_ALLOWED_DEV_ORIGINS=
